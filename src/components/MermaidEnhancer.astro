<div
  class="mermaid-modal-backdrop hidden"
  id="mermaid-modal"
  role="dialog"
  aria-modal="true"
  aria-label="Visualizador de diagrama em tela cheia"
>
  <div class="mermaid-modal-panel">
    <div class="mermaid-modal-bar">
      <span class="mermaid-modal-hint">arraste para mover · scroll para zoom</span>
      <div class="mermaid-modal-controls">
        <button type="button" id="mm-zoom-out" aria-label="Diminuir zoom">−</button>
        <span class="mm-zoom-value" id="mm-zoom-value">100%</span>
        <button type="button" id="mm-zoom-in" aria-label="Aumentar zoom">+</button>
        <button type="button" id="mm-zoom-reset" aria-label="Resetar zoom">reset</button>
        <button type="button" id="mm-close" class="mm-close-btn" aria-label="Fechar">
          fechar · ESC
        </button>
      </div>
    </div>
    <div class="mermaid-modal-stage" id="mm-stage">
      <div class="mermaid-modal-transform" id="mm-transform"></div>
    </div>
  </div>
</div>

<script>
  const pres = Array.from(
    document.querySelectorAll<HTMLPreElement>(
      '.prose pre.astro-code[data-language="mermaid"]',
    ),
  );

  if (pres.length > 0) {
    void (async () => {
      const { default: mermaid } = await import('mermaid');

      const figures: HTMLElement[] = [];

      // Replace Shiki mermaid <pre> blocks with interactive editorial figures
      pres.forEach((pre, index) => {
        const source = (pre.textContent ?? '').trim();
        const figure = document.createElement('figure');
        figure.className = 'mermaid-figure';
        figure.dataset.mermaidSrc = source;
        figure.dataset.mermaidIdx = String(index);
        figure.setAttribute('data-pagefind-ignore', '');

        const bar = document.createElement('div');
        bar.className = 'mermaid-bar';

        const label = document.createElement('span');
        label.textContent = 'diagrama · mermaid';

        const expandBtn = document.createElement('button');
        expandBtn.type = 'button';
        expandBtn.className = 'mermaid-expand-btn';
        expandBtn.textContent = 'ampliar ⤢';
        expandBtn.setAttribute('aria-label', 'Abrir diagrama em tela cheia com zoom');

        bar.append(label, expandBtn);

        const canvas = document.createElement('div');
        canvas.className = 'mermaid-canvas';
        canvas.setAttribute('role', 'button');
        canvas.setAttribute('tabindex', '0');
        canvas.setAttribute('aria-label', 'Clique para ampliar o diagrama');

        figure.append(bar, canvas);
        pre.replaceWith(figure);
        figures.push(figure);
      });

      function getThemeConfig(isDark: boolean) {
        return isDark
          ? {
              theme: 'base' as const,
              themeVariables: {
                darkMode: true,
                background: '#181A1D',
                primaryColor: '#202328',
                primaryTextColor: '#EAE8E3',
                primaryBorderColor: '#E3744F',
                secondaryColor: '#181A1D',
                secondaryTextColor: '#EAE8E3',
                secondaryBorderColor: '#3A3E46',
                tertiaryColor: '#111214',
                tertiaryTextColor: '#EAE8E3',
                tertiaryBorderColor: '#26282C',
                lineColor: '#93918B',
                edgeLabelBackground: '#181A1D',
                clusterBkg: '#141619',
                clusterBorder: '#2D3138',
                fontFamily: 'Inter, -apple-system, BlinkMacSystemFont, sans-serif',
                fontSize: '14px',
              },
            }
          : {
              theme: 'base' as const,
              themeVariables: {
                darkMode: false,
                background: '#F2EFE9',
                primaryColor: '#FAF9F6',
                primaryTextColor: '#1B1B1B',
                primaryBorderColor: '#C4512C',
                secondaryColor: '#F2EFE9',
                secondaryTextColor: '#1B1B1B',
                secondaryBorderColor: '#CBC5B8',
                tertiaryColor: '#FFFFFF',
                tertiaryTextColor: '#1B1B1B',
                tertiaryBorderColor: '#E5E1D8',
                lineColor: '#66635E',
                edgeLabelBackground: '#FAF9F6',
                clusterBkg: '#F7F5F0',
                clusterBorder: '#D9D3C7',
                fontFamily: 'Inter, -apple-system, BlinkMacSystemFont, sans-serif',
                fontSize: '14px',
              },
            };
      }

      let renderSeq = 0;

      async function renderAll() {
        const isDark = document.documentElement.getAttribute('data-theme') === 'dark';
        mermaid.initialize({
          startOnLoad: false,
          securityLevel: 'strict',
          flowchart: { curve: 'basis', padding: 14, htmlLabels: true },
          ...getThemeConfig(isDark),
        });

        for (const figure of figures) {
          const src = figure.dataset.mermaidSrc ?? '';
          const canvas = figure.querySelector<HTMLElement>('.mermaid-canvas');
          if (!src || !canvas) continue;

          renderSeq += 1;
          const id = `kamity-mermaid-${renderSeq}`;
          try {
            const { svg } = await mermaid.render(id, src);
            canvas.innerHTML = svg;
            const svgEl = canvas.querySelector('svg');
            if (svgEl) {
              svgEl.style.maxWidth = '100%';
              svgEl.style.height = 'auto';
            }
          } catch {
            canvas.textContent = 'Erro ao renderizar diagrama Mermaid.';
          }
        }
      }

      await renderAll();

      // Modal with zoom & pan
      const modal = document.getElementById('mermaid-modal');
      const stage = document.getElementById('mm-stage');
      const transformEl = document.getElementById('mm-transform');
      const zoomValueEl = document.getElementById('mm-zoom-value');
      const btnIn = document.getElementById('mm-zoom-in');
      const btnOut = document.getElementById('mm-zoom-out');
      const btnReset = document.getElementById('mm-zoom-reset');
      const btnClose = document.getElementById('mm-close');

      let activeFigure: HTMLElement | null = null;
      let scale = 1;
      let tx = 0;
      let ty = 0;
      let dragging = false;
      let dragStartX = 0;
      let dragStartY = 0;

      const MIN_SCALE = 0.4;
      const MAX_SCALE = 5;

      function applyTransform() {
        if (!transformEl || !zoomValueEl) return;
        transformEl.style.transform = `translate(${tx}px, ${ty}px) scale(${scale})`;
        zoomValueEl.textContent = `${Math.round(scale * 100)}%`;
      }

      function resetView() {
        scale = 1;
        tx = 0;
        ty = 0;
        applyTransform();
      }

      function syncModalSvg() {
        if (!activeFigure || !transformEl) return;
        const sourceSvg = activeFigure.querySelector('.mermaid-canvas svg');
        if (!sourceSvg) return;

        const clone = sourceSvg.cloneNode(true) as SVGSVGElement;
        clone.removeAttribute('style');
        clone.style.display = 'block';
        clone.style.maxWidth = 'none';
        clone.style.maxHeight = 'none';

        // Give narrow diagrams a comfortable baseline size in fullscreen
        const vb = clone.viewBox?.baseVal;
        if (vb && vb.width > 0 && vb.height > 0 && stage) {
          const stageW = Math.max(320, stage.clientWidth - 96);
          const stageH = Math.max(240, stage.clientHeight - 96);
          const fitRatio = Math.min(stageW / vb.width, stageH / vb.height, 2.2);
          clone.style.width = `${Math.round(vb.width * fitRatio)}px`;
          clone.style.height = `${Math.round(vb.height * fitRatio)}px`;
        }

        transformEl.replaceChildren(clone);
      }

      function openModal(figure: HTMLElement) {
        if (!modal) return;
        activeFigure = figure;
        modal.classList.remove('hidden');
        document.body.style.overflow = 'hidden';
        resetView();
        syncModalSvg();
      }

      function closeModal() {
        if (!modal) return;
        modal.classList.add('hidden');
        document.body.style.overflow = '';
        activeFigure = null;
      }

      function stepZoom(delta: number) {
        scale = Math.min(MAX_SCALE, Math.max(MIN_SCALE, Number((scale + delta).toFixed(2))));
        applyTransform();
      }

      figures.forEach((figure) => {
        const canvas = figure.querySelector<HTMLElement>('.mermaid-canvas');
        const expandBtn = figure.querySelector<HTMLButtonElement>('.mermaid-expand-btn');

        canvas?.addEventListener('click', () => openModal(figure));
        canvas?.addEventListener('keydown', (e) => {
          if (e.key === 'Enter' || e.key === ' ') {
            e.preventDefault();
            openModal(figure);
          }
        });
        expandBtn?.addEventListener('click', () => openModal(figure));
      });

      btnIn?.addEventListener('click', () => stepZoom(0.25));
      btnOut?.addEventListener('click', () => stepZoom(-0.25));
      btnReset?.addEventListener('click', resetView);
      btnClose?.addEventListener('click', closeModal);

      modal?.addEventListener('click', (e) => {
        if (e.target === modal) closeModal();
      });

      stage?.addEventListener(
        'wheel',
        (e) => {
          e.preventDefault();
          const factor = e.deltaY < 0 ? 0.18 : -0.18;
          stepZoom(factor * Math.max(1, scale * 0.6));
        },
        { passive: false },
      );

      stage?.addEventListener('dblclick', () => {
        if (scale > 1.05) {
          resetView();
        } else {
          stepZoom(0.75);
        }
      });

      stage?.addEventListener('pointerdown', (e) => {
        if (e.button !== 0) return;
        dragging = true;
        dragStartX = e.clientX - tx;
        dragStartY = e.clientY - ty;
        stage.classList.add('is-dragging');
        stage.setPointerCapture(e.pointerId);
      });

      stage?.addEventListener('pointermove', (e) => {
        if (!dragging) return;
        tx = e.clientX - dragStartX;
        ty = e.clientY - dragStartY;
        applyTransform();
      });

      const stopDrag = () => {
        dragging = false;
        stage?.classList.remove('is-dragging');
      };

      stage?.addEventListener('pointerup', stopDrag);
      stage?.addEventListener('pointercancel', stopDrag);

      document.addEventListener('keydown', (e) => {
        if (!modal || modal.classList.contains('hidden')) return;
        if (e.key === 'Escape') {
          closeModal();
        } else if (e.key === '+' || e.key === '=') {
          e.preventDefault();
          stepZoom(0.25);
        } else if (e.key === '-') {
          e.preventDefault();
          stepZoom(-0.25);
        } else if (e.key === '0') {
          e.preventDefault();
          resetView();
        }
      });

      // Re-render diagrams cleanly when user toggles dark/light mode
      const themeObserver = new MutationObserver(() => {
        void renderAll().then(() => {
          if (activeFigure) syncModalSvg();
        });
      });
      themeObserver.observe(document.documentElement, {
        attributes: true,
        attributeFilter: ['data-theme'],
      });
    })();
  }
</script>
